# Server
PORT=5000

# MySQL connection — set these to your Railway MySQL service variables
# (Railway also injects MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE automatically)
DB_HOST=your_mysql_host
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=employee_task_tracker

# Auth
JWT_SECRET=replace_with_secure_secret

# CORS — set frontend URL(s). For multiple origins, use comma-separated values.
# Example: CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173
